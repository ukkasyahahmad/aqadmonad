# All optional. Copy to web/.env.local (gitignored). Never commit real values.

# Photo uploads in /create (Vercel Blob). `vercel env pull` fills it for linked projects.
BLOB_READ_WRITE_TOKEN=

# Preferred Monad Testnet RPC; the official public RPCs are used as fallbacks.
NEXT_PUBLIC_RPC_URL=

# Max quick-bid wallets /api/faucet will fund (via the MONSKILLS faucet API; no private key needed).
DRIP_CAP=60
